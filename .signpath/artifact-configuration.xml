<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for FeroSSH releases. Paste it into the
  project's default artifact configuration on signpath.io.

  The release workflow uploads ferossh.exe and ferossh-desktop.exe as one
  GitHub artifact, which arrives as a zip. Both exes are Authenticode
  signed, and SignPath refuses them unless their version resource names
  the product FeroSSH (crates/app/build.rs writes it).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ferossh.exe" product-name="FeroSSH">
      <authenticode-sign />
    </pe-file>
    <pe-file path="ferossh-desktop.exe" product-name="FeroSSH">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
