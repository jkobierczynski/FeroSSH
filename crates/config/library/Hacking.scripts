# FeroSSH script library: hacking, for authorised penetration tests,
# CTFs and lab practice. Use these only on systems you own or have
# written permission to test. They are standard recon, enumeration and
# listener commands, no destructive payloads.
# Each Snippet block becomes one file in
# %APPDATA%\FeroSSH\scripts\Library\Hacking.

Snippet "Recon - nmap fast scan of the top ports"
    Line nmap -T4 -F --open ${1:10.10.10.10}

Snippet "Recon - nmap all TCP ports"
    Line sudo nmap -p- --min-rate ${2:2000} -T4 --open -oN nmap-all-${stamp}.txt ${1:10.10.10.10}

Snippet "Recon - nmap versions and default scripts"
    Line sudo nmap -sC -sV -p ${2:22,80,443} -oN nmap-svc-${stamp}.txt ${1:10.10.10.10}

Snippet "Recon - nmap top UDP ports"
    Line sudo nmap -sU --top-ports ${2:50} --open ${1:10.10.10.10}

Snippet "Recon - hosts up on a subnet"
    Line sudo nmap -sn ${1:10.10.10.0/24} -oG - | awk '/Up$$/{print $$2}'

Snippet "Recon - open ports from an nmap file, comma separated"
    Line grep -oP '^\d+(?=/tcp\s+open)' ${1:nmap-all.txt} | paste -sd,

Snippet "Web - headers and server banner"
    Line curl -skI ${1:https://10.10.10.10}

Snippet "Web - directory discovery (gobuster)"
    Line gobuster dir -u ${1:http://10.10.10.10} -w ${2:/usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt} -t 40 -x ${3:php,txt,html}

Snippet "Web - content discovery (ffuf)"
    Line ffuf -u ${1:http://10.10.10.10}/FUZZ -w ${2:/usr/share/seclists/Discovery/Web-Content/common.txt} -mc 200,204,301,302,307,401,403

Snippet "Web - virtual host discovery (ffuf)"
    Line ffuf -u http://${1:10.10.10.10} -H 'Host: FUZZ.${2:target.htb}' -w ${3:/usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt} -fs ${4:0}

Snippet "Web - technologies (whatweb)"
    Line whatweb -a 3 ${1:http://10.10.10.10}

Snippet "Web - robots.txt and sitemap"
    Line curl -sk ${1:http://10.10.10.10}/robots.txt; curl -sk ${1:http://10.10.10.10}/sitemap.xml | head -n 40

Snippet "SMB - shares without a password"
    Line smbclient -N -L //${1:10.10.10.10}

Snippet "SMB - enumerate with enum4linux-ng"
    Line enum4linux-ng -A ${1:10.10.10.10}

Snippet "SMB - shares and access with netexec"
    Line nxc smb ${1:10.10.10.10} -u '${2:guest}' -p '${3:}' --shares

Snippet "DNS - zone transfer attempt"
    Line dig axfr ${2:target.htb} @${1:10.10.10.10}

Snippet "DNS - subdomains from certificate logs"
    Line curl -s 'https://crt.sh/?q=%25.${1:example.com}&output=json' | jq -r '.[].name_value' | sort -u

Snippet "SNMP - walk with the public community"
    Line snmpwalk -v2c -c ${2:public} ${1:10.10.10.10} | head -n 100

Snippet "LDAP - base naming contexts"
    Line ldapsearch -x -H ldap://${1:10.10.10.10} -s base namingcontexts

Snippet "Listener - netcat on a port"
    Line rlwrap nc -lvnp ${1:4444}

Snippet "Listener - HTTP server to hand out files"
    Line python3 -m http.server ${1:8000}

Snippet "Listener - SMB server to hand out files"
    Line impacket-smbserver -smb2support ${1:share} ${2:.}

Snippet "Shell - make a raw shell a full TTY (on the target)"
    Line python3 -c 'import pty; pty.spawn("/bin/bash")' || script -qc /bin/bash /dev/null

Snippet "Shell - size a raw shell's terminal"
    Line export TERM=xterm-256color; stty rows ${1:50} cols ${2:200}

Snippet "Transfer - fetch a file with whatever is installed"
    Line curl -fsSO ${1:http://10.10.14.1:8000/file} || wget -q ${1:http://10.10.14.1:8000/file}

Snippet "Enum - sudo rights, SUID files and capabilities"
    Line sudo -l 2>/dev/null; find / -perm -4000 -type f 2>/dev/null; getcap -r / 2>/dev/null

Snippet "Enum - cron jobs and timers"
    Line cat /etc/crontab 2>/dev/null; ls -la /etc/cron.* 2>/dev/null; systemctl list-timers --all --no-pager 2>/dev/null

Snippet "Enum - world-writable files outside home"
    Line find / -perm -0002 -type f -not -path '/proc/*' -not -path '/sys/*' -not -path '/dev/*' -not -path '/run/*' -not -path "$$HOME/*" 2>/dev/null | head -n 50

Snippet "Enum - Windows user, groups and privileges"
    Line whoami /all

Snippet "Enum - Windows system info for privesc checks"
    Line systeminfo; wmic qfe get HotFixID,InstalledOn
