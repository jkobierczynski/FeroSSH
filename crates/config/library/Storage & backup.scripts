# FeroSSH script library: storage and backup (LVM, ZFS, rsync, tar).
# Mostly Linux; the LVM and ZFS commands need root. Each Snippet block
# becomes one file in %APPDATA%\FeroSSH\scripts\Library\Storage & backup.

Snippet "Disks - block devices and mounts"
    Line lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT,LABEL

Snippet "Disks - UUIDs for fstab"
    Line sudo blkid

Snippet "Disks - SMART health of a drive"
    Line sudo smartctl -H ${1:/dev/sda}

Snippet "LVM - physical volumes, groups and volumes"
    Line sudo pvs; sudo vgs; sudo lvs

Snippet "LVM - free space in volume groups"
    Line sudo vgs -o vg_name,vg_size,vg_free

Snippet "LVM - grow a volume and its filesystem"
    Line sudo lvextend -r -L +${2:10G} ${1:/dev/vg/lv}

Snippet "LVM - snapshot a volume"
    Line sudo lvcreate -s -n ${2:lv-snap} -L ${3:5G} ${1:/dev/vg/lv}

Snippet "ZFS - pools and their health"
    Line zpool status -x; zpool list

Snippet "ZFS - datasets with space used"
    Line zfs list -o name,used,avail,refer,mountpoint

Snippet "ZFS - snapshot a dataset"
    Line sudo zfs snapshot ${1:pool/dataset}@${2:$(date +%F-%H%M)}

Snippet "ZFS - scrub a pool"
    Line sudo zpool scrub ${1:pool}; zpool status ${1:pool}

Snippet "rsync - mirror a folder (dry run first)"
    Line rsync -aHAX --delete --dry-run ${1:src/} ${2:dst/}

Snippet "rsync - copy over SSH, resumable, with progress"
    Line rsync -aAX --partial --info=progress2 -e ssh ${1:src/} ${2:user@host:/dst/}

Snippet "rsync - back up, keeping changed files"
    Line rsync -aAX --delete --backup --backup-dir=../changed-${stamp} ${1:src/} ${2:dst/}

Snippet "tar - compressed archive of a folder"
    Line tar -I 'zstd -19 -T0' -cvf ${2:backup-${stamp}.tar.zst} ${1:folder}

Snippet "tar - gzip archive (portable)"
    Line tar -czvf ${2:backup-${stamp}.tar.gz} ${1:folder}

Snippet "tar - list an archive without extracting"
    Line tar -tvf ${1:archive.tar.gz} | less

Snippet "tar - extract into a named folder"
    Line mkdir -p ${2:out} && tar -xvf ${1:archive.tar.gz} -C ${2:out}

Snippet "Backup - a database dump folder, kept 7 days"
    Line find ${1:/backups} -name '*.sql.gz' -mtime +7 -print -delete
