# Prompts, echoes and redraws a shell (or a hostile host) prints, and
# what a command carrying a secret looks like.
"$ "
"# "
"% "
"jo@h:~$ "
"Password: "
"[sudo] password for jo: "
"PIN: "
"\x0d\x0a"
"\x1b[K"
"\x1b[4D"
"\x1b[C"
"\x1b[2J\x1b[H"
"\x1b[?1049h"
"\x08"
"\x7f"
"PASSWORD="
"--token "
"mysql -p"
"https://jo:x@h/"
"curl -u a:b"
"sshpass -p"
"git status"
