# Script verbs and the bits of syntax they take.
"expect "
"send "
"type "
"key "
"capture "
"password"
"secret enable"
"pause 1"
"delay 10ms"
"label a"
"goto a"
"on "
" goto a"
"timeout 1"
"timeout 1 goto a"
"set v "
"add v 1"
"if ${v} < 3 goto a"
"if ${captured} contains "
" == "
" != "
" >= "
"show "
"stop"
"fail "
"${v}"
"${captured}"
"\x0a"
"\x00"
"#"
"$ "
